[Unit]
Description=FlashLarry admin service
After=network-online.target flashlarry-social.service postgresql.service redis-server.service
Requires=flashlarry-social.service
Wants=network-online.target

[Service]
Type=simple
User=flashlarry
Group=flashlarry
EnvironmentFile=/etc/flashlarry/common.env
EnvironmentFile=/etc/flashlarry/admin.env
Environment=LISTEN_ADDR=127.0.0.1:8084
ExecStart=/opt/flashlarry/bin/admin
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
