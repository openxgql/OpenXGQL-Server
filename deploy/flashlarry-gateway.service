[Unit]
Description=Flashlarry GraphQL gateway
After=network-online.target flashlarry-users.service flashlarry-tweets.service flashlarry-social.service
Wants=network-online.target
Requires=flashlarry-users.service flashlarry-tweets.service flashlarry-social.service

[Service]
Type=simple
User=flashlarry
Group=flashlarry
EnvironmentFile=/etc/flashlarry/common.env
Environment=LISTEN_ADDR=127.0.0.1:8080
ExecStart=/opt/flashlarry/bin/gateway
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
